{
  "opencollection": "1.0.0",
  "info": {
    "name": "TrackingMore Air Waybills API",
    "version": "v4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Tracking-Api-Key",
      "value": "{{Tracking-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Air Waybills",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Track air waybill",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trackingmore.com/v4/awb",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Track an air cargo shipment using a Master Air Waybill (MAWB) number in format XXX-XXXXXXXX. Each air waybill track consumes 50 credits."
        }
      ]
    }
  ],
  "bundled": true
}