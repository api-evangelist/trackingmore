{
  "opencollection": "1.0.0",
  "info": {
    "name": "TrackingMore Air Waybills Couriers API",
    "version": "v4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Tracking-Api-Key",
      "value": "{{Tracking-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Couriers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all couriers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trackingmore.com/v4/couriers/all"
          },
          "docs": "Retrieve the full list of supported carriers/couriers available on the TrackingMore platform (1,300+ globally)."
        },
        {
          "info": {
            "name": "Detect courier",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trackingmore.com/v4/couriers/detect",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Automatically detect which carrier(s) a tracking number belongs to based on pattern matching and heuristics."
        }
      ]
    }
  ],
  "bundled": true
}